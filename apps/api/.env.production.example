# The API's settings on the live server (Coolify → crmnew-api → Environment Variables).
# Copy the names and fill the values there. Never commit the filled-in copy.
# Every value is read at run time only. In Coolify, set each to "Not available during build".

# --- Required -------------------------------------------------------------------------------

# Already set by the Dockerfile. Repeated so nobody unsets it: production refuses an embedded
# database and refuses to start without SECRETS_KEY.
NODE_ENV=production

# The port the API listens on inside its container. Nothing outside reaches it directly:
# the web app's nginx calls http://crmnew-api:4100.
PORT=4100

# The Postgres. Coolify → the PostgreSQL resource → "Postgres URL (internal)", e.g.
# postgres://postgres:<password>@<db-container>:5432/postgres
# A pooler address (Supabase :6543 or ?pgbouncer=true) turns prepared statements off by itself.
DATABASE_URL=

# How many connections the API keeps open to Postgres.
DATABASE_POOL=10

# The web app's public address, with https. The sign-in cookie is Secure because it starts with
# https, and CORS allows only this origin. No slash at the end.
WEB_URL=https://crm.example.com

# The company's common password: every seat signs in with it (Aryan's rule). Same value as on
# Render today. Never in code or docs.
JOIN_PASSWORD=

# Seals Facebook page tokens and mailbox passwords in the database. If you move the live
# database over, use the SAME value as on Render, or every channel must be connected again.
# For a brand-new database, make one with: openssl rand -base64 48
SECRETS_KEY=

# Seat login IDs end in this domain: hos1@2mginc.com.
LOGIN_DOMAIN=2mginc.com

# --- Files (photos, papers) -----------------------------------------------------------------

# "s3" = a private bucket; the database row keeps only the key (the plan's rule online).
# "db" keeps the bytes inside the database rows (works, but makes the database heavy).
STORAGE_DRIVER=s3
# Supabase Storage → S3 Connection (as on Render today), or Coolify's MinIO: http://<minio-container>:9000
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=files
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Online channels (Messenger webhook) ----------------------------------------------------

# Meta app → Settings → Basic → App secret. Several apps: separate with commas.
MESSENGER_APP_SECRET=
# The verify token typed in Meta's webhook setup (https://crm.example.com/webhooks/messenger).
MESSENGER_VERIFY_TOKEN=
# Empty = Meta's default Graph API version. Or pin one, e.g. v23.0
MESSENGER_GRAPH_VERSION=
# Reads every connected page and mailbox on a timer. Keep it on, and run ONE API container
# only: two would both read (the plan: "several API servers sharing the reading" is not built).
CHANNEL_JOBS=on

# --- First start on an EMPTY database only ---------------------------------------------------
# Makes the company's channels and one System admin when nobody exists yet. It does nothing once
# anyone exists. Remove both after the first start.
# ADMIN_EMAIL=admin@2mginc.com
# ADMIN_PASSWORD=

# --- Leave unset on the server ---------------------------------------------------------------
# SEED_DEMO / SEED_PASSWORD: demo people. Developer's computer only.
# MESSENGER_SINK / MAIL_SINK: fake Meta and mail. Ignored when NODE_ENV=production anyway.
# KEEP_AWAKE: only for Render's free plan. Off by default. A server of our own doesn't sleep.
# PGLITE_DIR: the embedded database. Not used in production.

# Each person's own PIN after the password, at the doors and on the desks' shared screens: on by
# default. PINS=off turns it off (not recommended).
# PINS=off
