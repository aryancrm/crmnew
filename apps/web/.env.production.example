# The web app's settings on the live server (Coolify → crmnew-web → Environment Variables).
# The web app itself is static files: nothing is read at build time. nginx reads one value when
# the container starts.

# Where nginx sends /api and /webhooks: the API's container on Docker's network.
# In Coolify that's the API's custom container name (Advanced → "crmnew-api") and its port.
# No slash at the end, no path.
API_UPSTREAM=http://crmnew-api:4100
