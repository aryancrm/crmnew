# Filled by the nginx image on start: ${API_UPSTREAM} is the API's address, e.g.
# http://crmnew-api:4100 (Coolify, the API's container name) or http://api:4100 (docker compose).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's own DNS, asked again every 30 s: the web app starts even while the API is down,
    # and finds the API's new container after a redeploy.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $api ${API_UPSTREAM};

    # Photos and papers are uploaded through the API.
    client_max_body_size 50m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        # Live updates are server-sent events: no buffering, long reads.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Meta and the websites call the address the web app is on.
    location /webhooks/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
    }

    # Vite's hashed files never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The app itself: every other path is a screen of the single-page app.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
