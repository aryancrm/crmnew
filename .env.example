# The API reads these. Copy to .env for your own computer; never commit .env.

# Empty = an embedded Postgres in new/.data/pg (nothing to install). Online: a Postgres address.
DATABASE_URL=

# The API's port.
PORT=4100

# The web app's address, for the sign-in cookie and CORS. Online: https://app.<domain>
WEB_URL=http://localhost:5180

# Only on a developer's computer: make the demo people (one per role) on start.
SEED_DEMO=1
# The password every demo person gets. Choose your own.
SEED_PASSWORD=change-me
