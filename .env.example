# The API reads these. Copy the ones you need to apps/api/.env for your own computer (read by pnpm dev:api); never commit it.

# Empty = an embedded Postgres in new/.data/pg (nothing to install). Online: a Postgres address.
DATABASE_URL=

# The API's port.
PORT=4100

# The web app's address, for the sign-in cookie and CORS. Online: https://app.<domain>
WEB_URL=http://localhost:5180

# Only on a developer's computer: make the demo people (one per role) on start.
SEED_DEMO=1
# The password every demo person gets. Choose your own.
SEED_PASSWORD=change-me

# Where photos and papers are kept. "db" (default) = inside the database rows. Online: "s3",
# a Supabase Storage bucket through its S3 endpoint (Storage → S3 Connection), private bucket.
STORAGE_DRIVER=db
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
